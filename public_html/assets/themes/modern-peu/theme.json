            "main_image_shadow": "deep",
            "main_image_border_radius": "xl",
            "thumbnail_border_width": "3px",
            "thumbnail_border_radius": "md",
            "thumbnail_hover_effect": "scale",
            "thumbnail_opacity_inactive": "0.8"
