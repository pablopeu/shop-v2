        "cards": {
            "border": true,
            "shadow": true,
            "rounded": false,
            "hover_effect": "lift-3d",
            "glassmorphism": true,
            "buttons": "hide",
            "buttons_position": "center",
            "buttons_spacing": "normal",
            "buttons_vertical_spacing": "normal"
        },
        "forms": {
            "style": "modern",
            "border_style": "solid",
            "focus_ring": true,
            "glow_effect": true
        },
        "badges": {
            "cart_shape": "round",
            "favorite_shape": "round"
        },
        "product_view": {
