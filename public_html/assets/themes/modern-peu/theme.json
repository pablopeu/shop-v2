            "2xl": "24px",
            "3xl": "32px",
            "4xl": "48px"
        },
        "font_weights": {
            "normal": "400",
            "medium": "500",
            "semibold": "600",
            "bold": "700",
            "extrabold": "800"
        },
        "line_heights": {
            "tight": "1.25",
            "normal": "1.6",
            "relaxed": "1.8"
        }
    },
    "spacing": {
        "base_unit": "8px",
        "scale": "custom",
        "values": {
            "xs": "4px",
            "sm": "8px",
            "md": "16px",
            "lg": "24px",
            "xl": "32px",
            "2xl": "48px",
            "3xl": "64px",
            "4xl": "96px"
        }
    },
    "borders": {
        "radius": {
            "none": "0",
            "sm": "0",
            "md": "0",
            "lg": "0",
