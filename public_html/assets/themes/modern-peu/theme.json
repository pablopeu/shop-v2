        "primary_dark": "#003d47",
        "primary_light": "#006b7b",
        "secondary": "#018790",
        "accent": "#00b7b5",
        "success": "#00b7b5",
        "warning": "#ffaa00",
        "error": "#e63946",
        "info": "#018790",
        "text": "#2d3748",
        "background": "#ffffff"
    },
    "typography": {
        "font_family": "sans-serif",
